# Portfolio — Apache config for Hostinger (static SPA hosting)

Options -MultiViews

# ---------------------------------------------------------------------------
# 1. Proxy the AviationPro weather API to avoid CORS in production.
#    Dev uses a Vite proxy; on the static host we rewrite /aviationweather/*
#    straight through to aviationweather.gov so fetch() calls keep working.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Proxy weather API requests (must come before the SPA fallback)
  RewriteCond %{HTTP:Authorization} ^$
  RewriteRule ^aviationweather/(.*) https://aviationweather.gov/$1 [P,L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---------------------------------------------------------------------------
# 2. SPA fallback — serve index.html for any route that isn't a real file/dir,
#    so deep links like /resume or /works work on refresh & share.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# ---------------------------------------------------------------------------
# 3. Caching — long-lived for hashed assets, short for HTML so updates ship fast
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  # Cache the PWA manifest + service worker so installs stay stable.
  ExpiresByType application/manifest+json "access plus 1 month"
</IfModule>

# ---------------------------------------------------------------------------
# 4. MIME types — ensure WebP + AVIF + manifest serve with correct headers
#    (older Apache builds don't know these by default; wrong type = broken images)
# ---------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
  AddType application/manifest+json .webmanifest
</IfModule>

# ---------------------------------------------------------------------------
# 5. Compression — Brotli first (best ratio), Gzip as fallback
# ---------------------------------------------------------------------------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript application/json font/woff2 application/manifest+json
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json font/woff2 application/manifest+json
</IfModule>
